---
// Card for a blog post chosen in the page content (e.g. the cases of the Google pages)
import { Image } from 'astro:assets';
import { imagem } from '../lib/imagens.mjs';
import { url, dataPorExtenso } from '../lib/site.mjs';

interface Props {
  post: { titulo: string; slug: string; resumo: string; data: string; imagem: string; categoria?: { nome: string } };
}

const { post } = Astro.props;
---

<li class="cartao">
  <a href={url(`/blog/${post.slug}/`)}>
    <Image src={imagem(post.imagem)} alt="" widths={[400, 800]} sizes="(max-width: 767px) 100vw, 400px" />
    <div class="cartao-corpo">
      {post.categoria && <span class="cartao-categoria">{post.categoria.nome}</span>}
      <h3>{post.titulo}</h3>
      <p>{post.resumo.split('\n')[0]}</p>
      <span class="cartao-data">{dataPorExtenso(post.data)}</span>
    </div>
  </a>
</li>

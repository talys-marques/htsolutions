---
// Newsletter sign-up on Emarsys (form 1404), sent into a hidden iframe like the old site
import Icon from './Icon.astro';
import { EMARSYS } from '../config.mjs';

interface Props {
  titulo?: string;
  texto?: string;
}

const { titulo = 'Newsletter', texto = '<p>Fique por dentro de todas as novidades.</p>' } = Astro.props;
---

<div class="newsletter">
  <h3>{titulo}</h3>
  <Fragment set:html={texto} />
  <form action={EMARSYS.acao} method="get" target="emarsys-newsletter" data-newsletter>
    <input type="hidden" name="CID" value={EMARSYS.cid} />
    <input type="hidden" name="f" value={EMARSYS.newsletter.f} />
    <input type="hidden" name="p" value="2" />
    <input type="hidden" name="a" value="r" />
    <input type="hidden" name="optin" value="y" />
    <label class="sr-only" for="newsletter-email">Seu e-mail</label>
    <input id="newsletter-email" name="inp_3" type="email" placeholder="Seu e-mail" autocomplete="email" required />
    <button type="submit" class="botao">Assinar</button>
  </form>
  <p class="formulario-ok" role="status" hidden><Icon nome="ok" /> Pronto! Você vai receber nossas novidades.</p>
  <iframe name="emarsys-newsletter" title="Cadastro na newsletter" hidden></iframe>
</div>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-newsletter]')) {
    form.addEventListener('submit', () => {
      setTimeout(() => {
        form.reset();
        form.parentElement.querySelector<HTMLElement>('.formulario-ok').hidden = false;
      }, 800);
    });
  }
</script>

---
// Partner logos with a short text (src/data/parceiros.json)
import { Image } from 'astro:assets';
import parceiros from '../data/parceiros.json';
import { imagem } from '../lib/imagens.mjs';
import { url } from '../lib/site.mjs';

const unicos = parceiros.filter((p) => p.logo);
---

<ul class="parceiros">
  {
    unicos.map((p) => (
      <li class="parceiro">
        <Image src={imagem(p.logo)} alt={p.nome} height={56} densities={[1, 2]} />
        <p>{p.texto}</p>
        <a href={url(p.link)}>Saiba mais</a>
      </li>
    ))
  }
</ul>

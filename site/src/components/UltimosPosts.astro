---
// Latest posts from the blog-system, read in the browser from /blog/ultimos.json
// (extension blog/extensions/ultimos-posts). Without it, only the link to the blog shows.
import Icon from './Icon.astro';
import { BLOG, APRESENTACAO } from '../config.mjs';
import { url } from '../lib/site.mjs';

interface Props {
  categoria?: string;
  quantidade?: number;
  link: { texto: string; href: string };
}

const { categoria = '', quantidade = 3, link } = Astro.props;
const endereco = APRESENTACAO
  ? url(BLOG.ultimosEstatico(categoria))
  : url(BLOG.ultimos) + `?n=${quantidade}` + (categoria ? `&categoria=${categoria}` : '');
---

<div class="ultimos" data-ultimos={endereco}>
  <ul class="cartoes" aria-live="polite"></ul>
  <a href={url(link.href)} class="botao botao-contorno">{link.texto} <Icon nome="seta" tamanho={18} /></a>
</div>

<script>
  const escapar = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);

  for (const bloco of document.querySelectorAll<HTMLElement>('[data-ultimos]')) {
    fetch(bloco.dataset.ultimos)
      .then((r) => (r.ok ? r.json() : []))
      .then((posts) => {
        bloco.querySelector('.cartoes').innerHTML = posts
          .map(
            (p) => `
            <li class="cartao">
              <a href="${escapar(p.url)}">
                ${p.cover ? `<img src="${escapar(p.cover)}" alt="" loading="lazy" width="400" height="225">` : ''}
                <div class="cartao-corpo">
                  ${p.category ? `<span class="cartao-categoria">${escapar(p.category)}</span>` : ''}
                  <h3>${escapar(p.title)}</h3>
                  <p>${escapar(p.excerpt)}</p>
                  <span class="cartao-data">${escapar(p.date)}</span>
                </div>
              </a>
            </li>`,
          )
          .join('');
      })
      .catch(() => {});
  }
</script>

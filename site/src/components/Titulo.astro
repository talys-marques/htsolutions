---
// Section heading: small label above ("Parceiros", "Cases") and the title, which may carry <br>/<strong>
import { semParagrafo } from '../lib/site.mjs';

interface Props {
  sobretitulo?: string;
  titulo: string;
  nivel?: 1 | 2;
  centro?: boolean;
}

const { sobretitulo, titulo, nivel = 2, centro = false } = Astro.props;
const Tag = `h${nivel}`;
---

<div class:list={['titulo', { centro }]}>
  {sobretitulo && <p class="sobretitulo">{sobretitulo}</p>}
  <Tag set:html={semParagrafo(titulo)} />
</div>

---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/img/logo-branco.png';
import { MENU } from '../config.mjs';
import { url, ativo, externo } from '../lib/site.mjs';

const { pathname } = Astro.url;
const alvo = (href: string) => (externo(href) ? { target: '_blank', rel: 'noopener' } : {});
---

<header class="topo">
  <div class="container topo-h">
    <a href={url('/')} class="topo-logo" aria-label="HT Solutions – página inicial">
      <Image src={logo} alt="HT Solutions" width={150} densities={[1, 2]} loading="eager" />
    </a>

    <button class="menu-botao" type="button" aria-expanded="false" aria-controls="menu-principal">
      <Icon nome="menu" class="menu-abrir" />
      <Icon nome="fechar" class="menu-fechar" />
      <span class="sr-only">Menu</span>
    </button>

    <nav id="menu-principal" class="menu" aria-label="Principal">
      <ul>
        {
          MENU.map((item) => {
            const atual = ativo(item.href, pathname) || item.submenu?.some((s) => ativo(s.href, pathname));
            return (
              <li class:list={[{ 'tem-sub': item.submenu }]}>
                <a href={url(item.href)} class:list={[{ atual }]} aria-current={atual ? 'page' : undefined} {...alvo(item.href)}>
                  {item.titulo}
                </a>
                {item.submenu && (
                  <>
                    <button class="sub-botao" type="button" aria-expanded="false" aria-label={`Abrir ${item.titulo}`}>
                      <Icon nome="baixo" tamanho={16} />
                    </button>
                    <ul class="submenu">
                      {item.submenu.map((s) => (
                        <li>
                          <a href={url(s.href)} {...alvo(s.href)}>
                            {s.titulo}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
              </li>
            );
          })
        }
      </ul>
      <a href="#contato" class="botao botao-claro topo-contato">Fale conosco</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('.topo');
  const botao = document.querySelector('.menu-botao');

  const fechar = () => {
    header.classList.remove('menu-aberto');
    botao.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('sem-rolagem');
  };

  botao?.addEventListener('click', () => {
    const aberto = header.classList.toggle('menu-aberto');
    botao.setAttribute('aria-expanded', String(aberto));
    document.body.classList.toggle('sem-rolagem', aberto);
  });

  // "Fale conosco" and in-page anchors close the mobile menu
  for (const link of header.querySelectorAll('a[href^="#"], a[href*="#"]')) link.addEventListener('click', fechar);

  // Submenus: hover on desktop, tap on the arrow in the mobile menu
  for (const sub of document.querySelectorAll('.sub-botao')) {
    sub.addEventListener('click', () => {
      const li = sub.closest('li');
      const aberto = li.classList.toggle('sub-aberto');
      sub.setAttribute('aria-expanded', String(aberto));
    });
  }
</script>

---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Titulo from '../components/Titulo.astro';
import CartaoPost from '../components/CartaoPost.astro';
import UltimosPosts from '../components/UltimosPosts.astro';
import Newsletter from '../components/Newsletter.astro';
import Icon from '../components/Icon.astro';
import pagina from '../data/googleparaempresas.json';
import { imagem } from '../lib/imagens.mjs';
import { url, semParagrafo } from '../lib/site.mjs';
import { BLOG } from '../config.mjs';

const { intro, definicao, cases, conteudo, case_destaque, ebook, blog } = pagina;
---

<Base
  titulo="Chrome Enterprise – Google para Empresas"
  descricao="Chrome Enterprise com a HT Solutions: Chrome OS, Chromebooks e o navegador Chrome com gerenciamento centralizado e segurança para a sua empresa."
  formulario="enterprise"
>
  <section class="cabecalho">
    <div class="container duas-colunas">
      <div>
        <Image src={imagem(intro.logo)} alt="Google Chrome Enterprise" height={64} densities={[1, 2]} class="intro-logo" />
        <h1 set:html={semParagrafo(intro.titulo)} />
        <p class="texto-grande" set:html={semParagrafo(intro.texto)} />
        <a href="#contato" class="botao botao-claro">Fale com um especialista</a>
      </div>
      <Image src={imagem(intro.imagem)} alt="Chromebook" widths={[612]} sizes="(max-width: 899px) 90vw, 560px" class="cabecalho-imagem" loading="eager" />
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <div class="texto texto-grande definicao" set:html={definicao.texto} />
      <ul class="publicos">
        {
          definicao.blocos.map((b) => (
            <li>
              <Image src={imagem(b.imagem)} alt="" widths={[267, 389]} sizes="300px" />
              <h3>{b.titulo}</h3>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="secao secao-cinza">
    <div class="container conteudos">
      {
        conteudo.map((c, i) => (
          <div class:list={['duas-colunas', { inverter: i % 2 }]}>
            <Image src={imagem(c.imagem)} alt="" widths={[485]} sizes="(max-width: 899px) 90vw, 485px" class="imagem-arredondada" />
            <div>
              <h2>{c.titulo}</h2>
              <div class="texto" set:html={c.texto} />
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <Titulo sobretitulo="Cases" titulo="Quem já usa as soluções Chrome" />
      <ul class="cartoes">
        <CartaoPost post={case_destaque} />
        {cases.map((c) => <CartaoPost post={c} />)}
      </ul>
      <a href={url(BLOG.cases)} class="botao botao-contorno">Veja mais cases <Icon nome="seta" tamanho={18} /></a>
    </div>
  </section>

  <section class="secao secao-marinho">
    <div class="container duas-colunas">
      <div>
        <Titulo sobretitulo={ebook.subtitulo} titulo={ebook.titulo} />
        <div class="texto texto-grande" set:html={ebook.texto} />
        <a href={url(ebook.botao.link)} class="botao botao-claro" download>{ebook.botao.texto} <Icon nome="download" tamanho={18} /></a>
      </div>
      <Image src={imagem(ebook.imagem)} alt="Capa do e-book" widths={[446]} sizes="320px" class="ebook-capa" />
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <Titulo sobretitulo={blog.subtitulo} titulo={blog.titulo} />
      <div class="blog-h">
        <UltimosPosts link={{ texto: 'Ver todas as notícias', href: BLOG.href }} />
        <Newsletter titulo={blog.newsletter.titulo} texto={blog.newsletter.texto} />
      </div>
    </div>
  </section>
</Base>

<style>
  .intro-logo {
    width: auto;
    height: 64px;
    margin-bottom: 24px;
    padding: 8px 14px;
    border-radius: 8px;
    background: var(--branco);
  }

  .definicao {
    max-width: 860px;
    margin: 0 auto 40px;
    text-align: center;
  }

  .publicos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }

  .publicos img {
    width: auto;
    height: 260px;
    margin: 0 auto 16px;
    object-fit: contain;
  }

  .conteudos {
    display: grid;
    gap: 64px;
  }

  .ebook-capa {
    justify-self: center;
    width: 280px;
  }
</style>

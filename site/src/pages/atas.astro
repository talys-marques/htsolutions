---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Titulo from '../components/Titulo.astro';
import Icon from '../components/Icon.astro';
import pagina from '../data/atas.json';
import { imagem } from '../lib/imagens.mjs';
import { url } from '../lib/site.mjs';

const { resumo, texto, titulo_atas, pdf_atas, duvida, saiba_mais, transparencia } = pagina;
---

<Base
  titulo="Atas de Registro de Preços"
  descricao="Órgãos públicos federais, estaduais e municipais podem aderir às Atas de Registro de Preços da HT Solutions: HPE, Dell, HP Inc. e Lenovo com agilidade e conformidade."
  formulario="atas"
>
  <section class="cabecalho">
    <div class="container">
      <Titulo titulo="Atas de Registro de Preços" nivel={1} />
      <div class="texto" set:html={resumo} />
    </div>
  </section>

  <section class="secao">
    <div class="container atas-chamada">
      <div class="texto texto-grande" set:html={texto} />
      <div>
        <h2>{titulo_atas}</h2>
        <a href={pdf_atas.link} class="botao" target="_blank" rel="noopener">{pdf_atas.texto} <Icon nome="externo" tamanho={18} /></a>
      </div>
    </div>
  </section>

  <section class="secao secao-cinza">
    <div class="container duas-colunas">
      <Titulo titulo={duvida.titulo} />
      <div>
        <div class="texto" set:html={duvida.texto} />
        <div class="botoes">
          <a href={duvida.botao.link} class="botao" target="_blank" rel="noopener">{duvida.botao.texto}</a>
          <a href="#contato" class="botao botao-contorno">Fale com um especialista</a>
        </div>
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="container duas-colunas">
      <Image src={imagem(saiba_mais.imagem)} alt="" widths={[488]} sizes="(max-width: 899px) 90vw, 488px" class="imagem-arredondada saiba-imagem" />
      <div>
        <Titulo sobretitulo={saiba_mais.subtitulo} titulo={saiba_mais.titulo} />
        <div class="texto" set:html={saiba_mais.texto} />
      </div>
    </div>
  </section>

  <section class="secao escuro transparencia">
    <div class="container">
      <p class="sobretitulo">Certigov · categoria Bronze</p>
      <h2>{transparencia.titulo}</h2>
      <p>{transparencia.texto}</p>
      <a href={url(transparencia.botao.link)} class="botao botao-claro">{transparencia.botao.texto} <Icon nome="seta" tamanho={18} /></a>
    </div>
  </section>
</Base>

<style>
  .atas-chamada {
    display: grid;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .atas-chamada {
      grid-template-columns: 1.4fr 1fr;
      gap: 64px;
    }
  }

  .atas-chamada h2 {
    font-size: 1.5rem;
  }

  .saiba-imagem {
    justify-self: center;
    width: min(420px, 100%);
  }

  .transparencia p {
    max-width: 680px;
    font-size: 1.15rem;
  }
</style>

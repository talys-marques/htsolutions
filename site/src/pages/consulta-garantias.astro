---
// Warranty lookup by serial number. public/assets/db_943hf3.bin is the warranty list encrypted
// with AES-GCM (key from PBKDF2), decrypted in the browser, as on the old site. The passphrase is
// in this page, so the encryption only hides the file from casual reading: anyone can decrypt it.
// To update the list, replace the .bin with a new one generated by the same tool.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { CONTATO } from '../config.mjs';
import { url } from '../lib/site.mjs';
---

<Base titulo="Consulta de garantia" descricao="Consulte a garantia do seu equipamento HT Solutions pelo número de série.">
  <section class="cabecalho">
    <div class="container">
      <h1>Consulta de garantia</h1>
      <p class="texto-grande">Digite o número de série do equipamento para ver a situação da garantia.</p>
    </div>
  </section>

  <section class="secao">
    <div class="container garantia" data-garantia={url('/assets/db_943hf3.bin')}>
      <form class="busca">
        <label for="serial" class="sr-only">Número de série</label>
        <input id="serial" type="text" placeholder="Digite o serial (ex.: ABC123456)" autocomplete="off" required />
        <button type="submit" class="botao"><Icon nome="busca" tamanho={18} /> Pesquisar</button>
      </form>
      <p class="mensagem" role="status" hidden></p>

      <div class="resultado" hidden>
        <table><tbody></tbody></table>
        <div class="suporte">
          <strong>Precisa abrir um chamado?</strong>
          <p>Atendimento técnico · segunda a sexta, das 8h às 18h</p>
          <a href={CONTATO.suporte.telefone.link}><Icon nome="telefone" tamanho={18} /> {CONTATO.suporte.telefone.texto}</a>
          <a href={`mailto:${CONTATO.suporte.email}`} data-email><Icon nome="email" tamanho={18} /> {CONTATO.suporte.email}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const PASSPHRASE = 'f3rn4nd0-g4r4nt14';
  const MAGIC = new TextEncoder().encode('EQPTv1\0');
  const SALT_LEN = 16;
  const IV_LEN = 12;

  type Registro = Record<string, string>;
  let base: Registro[] | null = null;

  async function carregar(endereco: string): Promise<Registro[]> {
    const resposta = await fetch(endereco, { cache: 'no-store' });
    if (!resposta.ok) throw new Error('não foi possível baixar a base de garantias.');
    const dados = new Uint8Array(await resposta.arrayBuffer());
    if (dados.length < MAGIC.length + SALT_LEN + IV_LEN || !MAGIC.every((b, i) => dados[i] === b)) {
      throw new Error('arquivo de garantias inválido.');
    }
    const salt = dados.slice(MAGIC.length, MAGIC.length + SALT_LEN);
    const iv = dados.slice(MAGIC.length + SALT_LEN, MAGIC.length + SALT_LEN + IV_LEN);
    const cifrado = dados.slice(MAGIC.length + SALT_LEN + IV_LEN);
    const material = await crypto.subtle.importKey('raw', new TextEncoder().encode(PASSPHRASE), 'PBKDF2', false, ['deriveKey']);
    const chave = await crypto.subtle.deriveKey(
      { name: 'PBKDF2', salt, iterations: 120000, hash: 'SHA-256' },
      material,
      { name: 'AES-GCM', length: 256 },
      false,
      ['decrypt'],
    );
    const texto = new TextDecoder().decode(await crypto.subtle.decrypt({ name: 'AES-GCM', iv, tagLength: 128 }, chave, cifrado));
    const lista = JSON.parse(texto);
    if (!Array.isArray(lista)) throw new Error('conteúdo inesperado na base de garantias.');
    return lista;
  }

  // Dates come as 2025-01-31 or 31/01/2025
  const lerData = (valor?: string) => {
    if (!valor) return null;
    const v = String(valor).trim();
    let m = v.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (m) return new Date(+m[1], +m[2] - 1, +m[3]);
    m = v.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
    if (m) return new Date(+m[3], +m[2] - 1, +m[1]);
    const d = new Date(v);
    return isNaN(d.getTime()) ? null : d;
  };
  const dataBR = (valor?: string) => lerData(valor)?.toLocaleDateString('pt-BR') ?? '';

  function situacao(r: Registro) {
    if (!lerData(r.data_ativacao_garantia)) return { classe: 'info', texto: 'Não ativada' };
    const vencimento = lerData(r.data_vencimento_garantia);
    if (!vencimento) return { classe: 'ruim', texto: 'Data inválida' };
    const hoje = new Date();
    hoje.setHours(0, 0, 0, 0);
    return hoje <= vencimento ? { classe: 'ok', texto: 'Vigente' } : { classe: 'ruim', texto: 'Expirada' };
  }

  const area = document.querySelector<HTMLElement>('[data-garantia]');
  const form = area.querySelector('form');
  const campo = area.querySelector<HTMLInputElement>('#serial');
  const mensagem = area.querySelector<HTMLElement>('.mensagem');
  const resultado = area.querySelector<HTMLElement>('.resultado');

  const avisar = (texto: string, erro = false) => {
    mensagem.textContent = texto;
    mensagem.classList.toggle('erro', erro);
    mensagem.hidden = false;
  };

  form.addEventListener('submit', async (evento) => {
    evento.preventDefault();
    resultado.hidden = true;
    const normalizar = (s: string) => String(s ?? '').replace(/\s+/g, '').toUpperCase();
    const serial = normalizar(campo.value);
    if (!serial) return avisar('Digite um serial para pesquisar.', true);
    try {
      avisar('Pesquisando...');
      base ??= await carregar(area.dataset.garantia);
      const r = base.find((item) => normalizar(item.serial) === serial);
      if (!r) return avisar('Serial não localizado.', true);

      const s = situacao(r);
      const linhas: [string, string][] = [
        ['Serial', r.serial],
        ['Nome do equipamento', r.nome_equipamento],
        ['Tipo de equipamento', r.tipo_equipamento],
        ['Nome do cliente', r.nome_cliente],
        ['Contrato', r.contrato],
        ['Data da venda', dataBR(r.data_venda)],
        ['Período de garantia', r.periodo_garantia],
        ['Tipo de garantia', r.tipo_garantia],
        ['Data de ativação da garantia', dataBR(r.data_ativacao_garantia)],
        ['Data de vencimento da garantia', dataBR(r.data_vencimento_garantia)],
      ];
      const tbody = resultado.querySelector('tbody');
      tbody.replaceChildren(
        ...linhas.map(([rotulo, valor]) => {
          const tr = document.createElement('tr');
          const th = document.createElement('th');
          const td = document.createElement('td');
          th.textContent = rotulo;
          td.textContent = valor ?? '';
          tr.append(th, td);
          return tr;
        }),
      );
      const tr = document.createElement('tr');
      tr.innerHTML = '<th>Situação da garantia</th><td><span class="selo"></span></td>';
      const selo = tr.querySelector('.selo');
      selo.textContent = s.texto;
      selo.classList.add(s.classe);
      tbody.append(tr);

      const email = resultado.querySelector<HTMLAnchorElement>('[data-email]');
      email.href = email.href.split('?')[0] + '?subject=' + encodeURIComponent(`Abertura de chamado - Serial ${r.serial}`);
      mensagem.hidden = true;
      resultado.hidden = false;
    } catch (erro) {
      avisar('Erro ao buscar: ' + (erro?.message || 'tente novamente.'), true);
    }
  });
</script>

<style>
  .garantia {
    max-width: 820px;
  }

  .busca {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .busca input {
    flex: 1 1 260px;
    padding: 14px 16px;
    border: 1px solid #c4d3e8;
    border-radius: 8px;
    font: inherit;
    font-size: 1.1rem;
  }

  .mensagem {
    margin-top: 16px;
    color: var(--suave);
    font-weight: 600;
  }

  .mensagem.erro {
    color: #b42318;
  }

  .resultado {
    margin-top: 32px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 32px;
  }

  :global(.resultado th),
  :global(.resultado td) {
    padding: 12px 14px;
    border-bottom: 1px solid var(--borda);
    text-align: left;
    vertical-align: top;
  }

  :global(.resultado th) {
    width: 40%;
    color: var(--suave);
    font-weight: 500;
  }

  :global(.selo) {
    display: inline-block;
    padding: 2px 12px;
    border-radius: 999px;
    font-weight: 700;
  }

  :global(.selo.ok) {
    background: #d1f2df;
    color: #11643a;
  }

  :global(.selo.ruim) {
    background: #fde2e1;
    color: #b42318;
  }

  :global(.selo.info) {
    background: var(--azul-suave);
    color: var(--marinho);
  }

  .suporte {
    display: grid;
    gap: 6px;
    padding: 24px;
    border-radius: var(--raio);
    background: var(--cinza);
  }

  .suporte p {
    margin: 0 0 8px;
    color: var(--suave);
  }

  .suporte a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
</style>

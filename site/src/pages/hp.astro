---
// HP Inc showcase: HP's own syndication script fills the page with their products (content by HP)
import Base from '../layouts/Base.astro';
---

<Base titulo="HP Inc" descricao="Notebooks, desktops, workstations e monitores HP com a HT Solutions, parceira HP Inc.">
  <section class="cabecalho">
    <div class="container">
      <h1>HT Solutions e HP Inc</h1>
      <p class="texto-grande">Notebooks, desktops, workstations e monitores HP com o atendimento e a garantia da HT Solutions.</p>
      <a href="#contato" class="botao botao-claro">Fale com um especialista</a>
    </div>
  </section>

  <section class="vitrine-hp">
    <script is:inline type="text/javascript" src="https://syndication.inc.hp.com/inpage/contentid.min.js#Yz1zaG93Y2FzZS91cy9lbiZtPUxBJmNjPWJyJnA9My1IV0tLLTQ5"></script>
  </section>
</Base>

<style>
  .vitrine-hp {
    min-height: 400px;
  }

  .vitrine-hp :global(.hp-inpage),
  .vitrine-hp :global(.hp-inpage iframe) {
    display: block;
    width: 100%;
    max-width: 100%;
    border: 0;
  }
</style>

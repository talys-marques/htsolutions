---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Titulo from '../components/Titulo.astro';
import CartaoPost from '../components/CartaoPost.astro';
import Icon from '../components/Icon.astro';
import pagina from '../data/educacao.json';
import { imagem } from '../lib/imagens.mjs';
import { url, semParagrafo } from '../lib/site.mjs';

const { intro, case: caso, destaques, definicao, motivos, playlist, ebook } = pagina;

// youtu.be/ID → embed without tracking cookies until the visitor plays
const embed = (link: string) => `https://www.youtube-nocookie.com/embed/${link.split('/').pop()}`;
const casoVideo = ebook.texto.match(/src="([^"]+)"/)?.[1]?.replace('www.youtube.com', 'www.youtube-nocookie.com');
---

<Base
  titulo="Google for Education"
  descricao="A HT Solutions é um dos maiores parceiros do Google for Education na América Latina: Chromebooks, Google Workspace for Education e Google Classroom para escolas públicas e privadas."
  formulario="educacao"
>
  <section class="cabecalho">
    <div class="container duas-colunas">
      <div>
        <Image src={imagem(intro.logo)} alt="Google for Education" height={42} densities={[1, 2]} class="intro-logo" />
        <h1 set:html={semParagrafo(intro.titulo)} />
        <div class="texto" set:html={intro.texto} />
        <a href="#contato" class="botao botao-claro">Fale com um especialista</a>
      </div>
      <Image src={imagem(intro.imagem)} alt="" widths={[400, 795]} sizes="(max-width: 899px) 90vw, 520px" class="cabecalho-imagem" loading="eager" />
    </div>
  </section>

  <section class="secao-marinho faixa-numeros">
    <div class="container">
      <ul class="numeros">
        {destaques.map((d) => <li><strong>{d.titulo}</strong> {d.texto}</li>)}
      </ul>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <div class="duas-colunas">
        <div>
          <Titulo titulo={definicao.titulo} />
          <div class="texto texto-grande" set:html={definicao.texto} />
          <a href={url(definicao.botao.link)} class="botao">{definicao.botao.texto} <Icon nome="seta" tamanho={18} /></a>
        </div>
        <ul class="ferramentas">
          {
            definicao.blocos.map((b) => (
              <li>
                <Image src={imagem(b.imagem)} alt="" height={40} densities={[1, 2]} />
                <div class="texto" set:html={b.texto} />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="secao secao-azul">
    <div class="container">
      <Titulo titulo={motivos.titulo} centro />
      <ul class="motivos">
        {
          motivos.blocos.map((m) => (
            <li>
              <Image src={imagem(m.icone)} alt="" width={48} densities={[1, 2]} />
              <h3>{m.titulo}</h3>
              <div class="texto" set:html={m.texto} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <Titulo sobretitulo={playlist.titulo_playlist} titulo={playlist.titulo} />
      <div class="playlist" data-playlist>
        <div class="video-embed">
          <iframe src={embed(playlist.video[0].link)} title={playlist.video[0].titulo} loading="lazy" allow="encrypted-media; picture-in-picture" allowfullscreen></iframe>
        </div>
        <ol>
          {
            playlist.video.map((v, i) => (
              <li>
                <button type="button" data-video={embed(v.link)} aria-current={i === 0 ? 'true' : undefined}>
                  <Icon nome="play" tamanho={16} />
                  <span>{v.titulo}</span>
                  <small>{v.duracao}</small>
                </button>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="secao secao-cinza">
    <div class="container duas-colunas">
      <div>
        <Titulo sobretitulo={ebook.subtitulo} titulo={ebook.titulo} />
        <ul class="cartoes cartao-unico"><CartaoPost post={caso} /></ul>
        <a href={url(ebook.botao.link)} class="botao botao-contorno">{ebook.botao.texto} <Icon nome="seta" tamanho={18} /></a>
      </div>
      {
        casoVideo && (
          <div class="video-embed">
            <iframe src={casoVideo} title={ebook.titulo} loading="lazy" allow="encrypted-media; picture-in-picture" allowfullscreen />
          </div>
        )
      }
    </div>
  </section>
</Base>

<script>
  for (const lista of document.querySelectorAll('[data-playlist]')) {
    const iframe = lista.querySelector('iframe');
    const botoes = [...lista.querySelectorAll<HTMLButtonElement>('button[data-video]')];
    for (const b of botoes) {
      b.addEventListener('click', () => {
        iframe.src = b.dataset.video + '?autoplay=1';
        iframe.title = b.querySelector('span').textContent;
        botoes.forEach((x) => (x === b ? x.setAttribute('aria-current', 'true') : x.removeAttribute('aria-current')));
      });
    }
  }
</script>

<style>
  .intro-logo {
    width: auto;
    height: 42px;
    margin-bottom: 24px;
    padding: 8px 12px;
    border-radius: 8px;
    background: var(--branco);
    box-sizing: content-box;
  }

  .faixa-numeros {
    padding-block: 40px;
  }

  .ferramentas {
    display: grid;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ferramentas li {
    padding: 24px;
    border-radius: var(--raio);
    background: var(--cinza);
  }

  .ferramentas img {
    width: auto;
    height: 40px;
    margin-bottom: 12px;
  }

  .motivos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .motivos li {
    padding: 28px;
    border-radius: var(--raio);
    background: var(--branco);
  }

  .motivos img {
    width: 48px;
    height: 48px;
    margin-bottom: 16px;
  }

  .playlist {
    display: grid;
    gap: 24px;
  }

  @media (min-width: 900px) {
    .playlist {
      grid-template-columns: 1.8fr 1fr;
      align-items: start;
    }
  }

  .playlist ol {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .playlist button {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--borda);
    border-radius: 8px;
    background: var(--branco);
    color: var(--texto);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .playlist button span {
    flex: 1;
  }

  .playlist button small {
    color: var(--suave);
  }

  .playlist button[aria-current] {
    border-color: var(--azul);
    background: var(--azul-suave);
    color: var(--marinho);
    font-weight: 600;
  }

  .cartao-unico {
    grid-template-columns: 1fr;
    max-width: 420px;
  }
</style>

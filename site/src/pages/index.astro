---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Titulo from '../components/Titulo.astro';
import UltimosPosts from '../components/UltimosPosts.astro';
import Newsletter from '../components/Newsletter.astro';
import Icon from '../components/Icon.astro';
import home from '../data/home.json';
import parceiros from '../data/parceiros.json';
import { imagem } from '../lib/imagens.mjs';
import { url, externo, semParagrafo } from '../lib/site.mjs';
import { BLOG } from '../config.mjs';

const { banner, solucoes, quem_somos, parceiros: secaoParceiros, cases, blog } = home;
// The old slider: the first slide is the hero, the others become shortcut cards
const [destaque, ...atalhos] = banner;
// Last word of the hero title gets the gradient ("Tecnologia que <strong>performa</strong>")
const tituloHero = destaque.titulo.replace(/(\S+)$/, '<strong>$1</strong>');

// Figures taken from the content of the other pages (quem-somos.json, educacao.json, home.json)
const NUMEROS = [
  { valor: '+19 anos', texto: 'no mercado de tecnologia B2B' },
  { valor: '+50 mil', texto: 'Chromebooks entregues em projetos de educação' },
  { valor: '11', texto: 'fabricantes parceiros de renome mundial' },
  { valor: 'Brasil', texto: 'empresas, órgãos públicos e escolas em todo o país' },
];
// Hero collage: real HT moments (education project, team, award), not the stock photos of the solutions below
const COLAGEM = ['design-sem-nome-5-e5975fd685', 'foto-3-d1f493047c-ddc16a9fa2', 'design-sem-nome-7-e74294e292-453deead27'];
// Shortcut icon by destination
const iconeAtalho = (link: string) =>
  link.includes('produtos.') ? 'carrinho' : link.includes('atas') ? 'documento' : link.includes('educacao') ? 'capelo' : link.includes('quem-somos') ? 'predio' : 'parceria';
const alvo = (href: string) => (externo(href) ? { target: '_blank', rel: 'noopener' } : {});
---

<Base>
  <section class="hero escuro">
    <div class="container hero-h">
      <div class="hero-texto">
        <p class="sobretitulo">Integradora de TI · Grupo Herval</p>
        <h1 set:html={tituloHero} />
        <p class="hero-lead" set:html={semParagrafo(destaque.texto)} />
        <div class="botoes">
          <a href="#contato" class="botao">Fale com um especialista <Icon nome="seta" tamanho={18} /></a>
          <a href={url('/servicos/')} class="botao botao-fantasma">Conheça as soluções</a>
        </div>
        <p class="hero-marcas">Parceira <span>Dell</span> · <span>HPE</span> · <span>HP</span> · <span>Google</span> · <span>Lenovo</span> · <span>Samsung</span></p>
      </div>
      <div class="hero-colagem" aria-hidden="true">
        <Image src={imagem(COLAGEM[0])} alt="" widths={[480, 960]} sizes="(max-width: 899px) 70vw, 420px" loading="eager" fetchpriority="high" class="colagem-a" />
        <Image src={imagem(COLAGEM[1])} alt="" widths={[300, 600]} sizes="240px" loading="eager" class="colagem-b" />
        <Image src={imagem(COLAGEM[2])} alt="" widths={[300, 600]} sizes="240px" loading="eager" class="colagem-c" />
        <div class="colagem-selo">
          <strong>+19 anos</strong>
          <span>transformando desafios em soluções</span>
        </div>
      </div>
    </div>
  </section>

  <section class="atalhos-secao" aria-label="Acesso rápido">
    <div class="container">
      <ul class="atalhos">
        {
          atalhos.map((a) => (
            <li>
              <a href={url(a.botao.link)} class="atalho" {...alvo(a.botao.link)}>
                <span class="atalho-icone"><Icon nome={iconeAtalho(a.botao.link)} tamanho={22} /></span>
                <span class="atalho-corpo">
                  <strong>{a.titulo}</strong>
                  <span set:html={semParagrafo(a.texto)} />
                  <span class="atalho-link">
                    {a.botao.texto} <Icon nome={externo(a.botao.link) ? 'externo' : 'seta'} tamanho={16} />
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="numeros-secao" aria-label="A HT em números">
    <div class="container">
      <ul class="numeros-home">
        {NUMEROS.map((n) => <li><strong>{n.valor}</strong> <span>{n.texto}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <div class="solucoes-topo">
        <Titulo sobretitulo="Soluções" titulo={solucoes.titulo} />
        <div>
          <div class="texto" set:html={solucoes.texto} />
          <a href={url(solucoes.botao.link)} class="link-seta">Ver todas as soluções <Icon nome="seta" tamanho={18} /></a>
        </div>
      </div>
      <ul class="bento">
        {
          solucoes.solucao.map((s, i) => (
            <li class:list={{ grande: i === 0 }}>
              <a href={url(s.link)}>
                <Image src={imagem(s.imagem)} alt="" widths={[480, 960, 1400]} sizes={i === 0 ? '(max-width: 899px) 100vw, 760px' : '(max-width: 899px) 100vw, 400px'} />
                <span class="bento-texto">
                  <strong>{s.titulo}</strong>
                  <span>{s.texto}</span>
                </span>
                <span class="bento-seta"><Icon nome="seta" /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="secao secao-cinza">
    <div class="container duas-colunas">
      <div>
        <Titulo sobretitulo={quem_somos.subtitulo} titulo={quem_somos.titulo} />
        <div class="texto texto-grande" set:html={quem_somos.texto} />
        <ul class="lista-check">
          <li><Icon nome="ok" /> Revenda com as mais altas certificações HPE, HP, Dell, Lenovo e Veeam</li>
          <li><Icon nome="ok" /> Equipe técnica própria para projeto, implantação e suporte</li>
          <li><Icon nome="ok" /> Atendimento ao setor privado, público e educacional</li>
        </ul>
        <a href={url('/quem-somos/')} class="botao botao-contorno">Conheça nossa história</a>
      </div>
      <div class="video-moldura">
        <video class="video" src={quem_somos.video} controls preload="metadata" playsinline></video>
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <Titulo sobretitulo={secaoParceiros.subtitulo} titulo={secaoParceiros.titulo} centro />
      <ul class="logos">
        {
          parceiros.map((p) => (
            <li title={p.texto}>
              <Image src={imagem(p.logo)} alt={p.nome} height={44} densities={[1, 2]} />
            </li>
          ))
        }
      </ul>
      <p class="centro-link"><a href={url('/quem-somos/#parceiros')} class="link-seta">O que fazemos com cada parceiro <Icon nome="seta" tamanho={18} /></a></p>
    </div>
  </section>

  <section class="secao secao-cinza">
    <div class="container">
      <div class="secao-topo">
        <Titulo sobretitulo={cases.subtitulo} titulo={cases.titulo} />
      </div>
      <UltimosPosts categoria="cases" link={{ texto: 'Ver todos os cases', href: BLOG.cases }} />
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <Titulo sobretitulo="Blog" titulo={blog.titulo} />
      <div class="blog-h">
        <UltimosPosts link={{ texto: 'Ver todas as notícias', href: BLOG.href }} />
        <Newsletter titulo={blog.newsletter.titulo} texto={blog.newsletter.texto} />
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(70% 80% at 70% 40%, #000, transparent);
    pointer-events: none;
  }

  .hero-h {
    position: relative;
    display: grid;
    gap: 56px;
    align-items: center;
    padding-block: clamp(64px, 4rem + 4vw, 128px) clamp(120px, 8rem + 3vw, 168px);
  }

  @media (min-width: 900px) {
    .hero-h {
      grid-template-columns: 1.05fr 1fr;
    }
  }

  .hero h1 {
    font-size: clamp(2.7rem, 1.6rem + 4.4vw, 4.9rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .hero-lead {
    max-width: 520px;
    font-size: clamp(1.08rem, 1rem + 0.4vw, 1.25rem);
  }

  .hero-marcas {
    margin: 36px 0 0;
    color: rgb(183 198 220 / 0.75);
    font-size: 0.88rem;
  }

  .hero-marcas span {
    color: var(--branco);
    font-weight: 600;
  }

  .hero-colagem {
    position: relative;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 16px;
    height: clamp(320px, 30vw, 460px);
  }

  .hero-colagem img {
    width: 100%;
    height: 100%;
    border-radius: 20px;
    object-fit: cover;
    box-shadow: var(--sombra-forte);
  }

  .colagem-a {
    grid-row: 1 / 3;
  }

  .colagem-selo {
    position: absolute;
    left: -24px;
    bottom: 28px;
    display: grid;
    max-width: 200px;
    padding: 16px 20px;
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 16px;
    background: rgb(255 255 255 / 0.92);
    color: var(--suave);
    font-size: 0.82rem;
    line-height: 1.4;
    box-shadow: var(--sombra-forte);
    backdrop-filter: blur(8px);
  }

  .colagem-selo strong {
    background: var(--gradiente);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: 1.6rem;
    letter-spacing: -0.03em;
  }

  @media (max-width: 899px) {
    .colagem-selo {
      left: 12px;
    }
  }

  /* ---------- Shortcuts (old slides) ---------- */
  .atalhos-secao {
    position: relative;
    z-index: 1;
    margin-top: calc(-1 * clamp(72px, 5rem + 2vw, 112px));
  }

  .atalhos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .atalho {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    background: var(--branco);
    color: var(--suave);
    font-size: 0.9rem;
    line-height: 1.5;
    text-decoration: none;
    box-shadow: var(--sombra);
    transition: transform 0.25s, box-shadow 0.25s;
  }

  .atalho:hover {
    box-shadow: var(--sombra-forte);
    transform: translateY(-4px);
  }

  .atalho-icone {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin: 20px 18px 0;
    border-radius: 12px;
    background: var(--azul-suave);
    color: var(--azul);
    transition: background-color 0.2s, color 0.2s;
  }

  .atalho:hover .atalho-icone {
    background: var(--azul);
    color: var(--branco);
  }

  .atalho-corpo {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px 18px;
  }

  .atalho-corpo strong {
    color: var(--preto);
    font-size: 1.02rem;
    letter-spacing: -0.01em;
  }

  .atalho-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 8px;
    color: var(--azul);
    font-weight: 600;
  }

  /* ---------- Numbers ---------- */
  .numeros-secao {
    padding-block: 64px 8px;
  }

  .numeros-home {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .numeros-home li {
    display: grid;
    gap: 4px;
    padding-top: 20px;
    border-top: 1px solid var(--borda);
    color: var(--suave);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .numeros-home strong {
    background: var(--gradiente);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: clamp(2rem, 1.5rem + 1.6vw, 2.8rem);
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  /* ---------- Solutions bento ---------- */
  .solucoes-topo {
    display: grid;
    gap: 8px 72px;
    align-items: start;
    margin-bottom: 40px;
  }

  @media (min-width: 900px) {
    .solucoes-topo {
      grid-template-columns: 1fr 1fr;
    }

    .solucoes-topo :global(.titulo) {
      margin-bottom: 0;
    }
  }

  .solucoes-topo .texto {
    margin-bottom: 12px;
    color: var(--suave);
  }

  .bento {
    display: grid;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    .bento {
      grid-template-columns: 2fr 1fr;
      grid-template-rows: 280px 280px;
    }

    .bento .grande {
      grid-row: 1 / 3;
    }
  }

  .bento a {
    position: relative;
    display: block;
    height: 100%;
    min-height: 280px;
    overflow: hidden;
    border-radius: 20px;
    color: var(--branco);
    text-decoration: none;
  }

  .bento img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s;
  }

  .bento a::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 30%, rgb(6 21 43 / 0.92));
  }

  .bento a:hover img {
    transform: scale(1.05);
  }

  .bento-texto {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    display: grid;
    gap: 6px;
    max-width: 560px;
    padding: 28px;
    color: var(--sobre-escuro);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .bento-texto strong {
    color: var(--branco);
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .bento-seta {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.15);
    backdrop-filter: blur(8px);
    transition: background-color 0.2s;
  }

  .bento a:hover .bento-seta {
    background: var(--azul);
  }

  /* ---------- About ---------- */
  .lista-check {
    display: grid;
    gap: 12px;
    margin: 24px 0 32px;
    padding: 0;
    list-style: none;
    color: var(--preto);
    font-weight: 500;
  }

  .lista-check li {
    display: flex;
    gap: 12px;
  }

  .lista-check :global(.icone) {
    flex: none;
    margin-top: 3px;
    color: var(--azul);
  }

  .video-moldura {
    position: relative;
  }

  .video-moldura::before {
    content: '';
    position: absolute;
    inset: -14px -14px 14px 14px;
    border-radius: 24px;
    background: var(--gradiente);
    opacity: 0.18;
  }

  .video-moldura .video {
    position: relative;
  }

  /* ---------- Partner logos ---------- */
  .logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .logos li {
    display: grid;
    place-items: center;
    flex: 0 1 172px;
    height: 100px;
    padding: 20px;
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    background: var(--branco);
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .logos li:hover {
    border-color: transparent;
    box-shadow: var(--sombra);
  }

  .logos img {
    width: auto;
    max-width: 100%;
    height: 44px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.7;
    transition: filter 0.2s, opacity 0.2s;
  }

  .logos li:hover img {
    filter: none;
    opacity: 1;
  }

  .centro-link {
    margin: 32px 0 0;
    text-align: center;
  }
</style>
